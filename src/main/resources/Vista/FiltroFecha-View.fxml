<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox stylesheets="@../css/StyleReportes.css" styleClass="filtro-modal-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controlador.FiltroFechaController" spacing="18">
    <padding>
        <Insets top="24" right="26" bottom="22" left="26"/>
    </padding>
    <children>

        <VBox spacing="4">
            <children>
                <Label fx:id="lblTitulo" text="Filtrar Clientes" styleClass="filtro-modal-title"/>
                <Label text="Deja los campos vacíos para incluir todos los registros" styleClass="filtro-modal-subtitle" wrapText="true"/>
            </children>
        </VBox>

        <VBox spacing="10">
            <children>
                <VBox spacing="4">
                    <children>
                        <Label text="Fecha de inicio" styleClass="filtro-field-label"/>
                        <DatePicker fx:id="dpDesde" styleClass="filtro-date-picker" promptText="DD/MM/AAAA" maxWidth="Infinity"/>
                        <Label fx:id="lblErrorDesde" styleClass="lbl-error" managed="false" visible="false" wrapText="true"/>
                    </children>
                </VBox>
                <VBox spacing="4">
                    <children>
                        <Label text="Fecha final" styleClass="filtro-field-label"/>
                        <DatePicker fx:id="dpHasta" styleClass="filtro-date-picker" promptText="DD/MM/AAAA" maxWidth="Infinity"/>
                        <Label fx:id="lblErrorHasta" styleClass="lbl-error" managed="false" visible="false" wrapText="true"/>
                    </children>
                </VBox>
            </children>
        </VBox>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <children>
                <Button text="Limpiar Todo" onAction="#limpiarFiltro" styleClass="btn-filtro-limpiar"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Cancelar" onAction="#cancelar" styleClass="btn-filtro-cancelar"/>
                <Button text="Guardar" onAction="#guardar" styleClass="btn-filtro-guardar"/>
            </children>
        </HBox>

    </children>
</VBox>