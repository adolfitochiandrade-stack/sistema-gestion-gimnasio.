<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox stylesheets="@../css/StyleMenu.css" styleClass="menu-main-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controlador.MainController">
    <children>

        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
            <children>
                <Label text="GymAdmin" styleClass="top-logo"/>
                <Label text="  |  Menú Principal" styleClass="top-breadcrumb"/>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnReportes" text="📊 Reportes" onAction="#handleAbrirReportes" styleClass="reportes-menu-button"/>
                <Button fx:id="btnEmpleados" text="👥 Empleados" onAction="#handleAbrirEmpleados" styleClass="empleados-menu-button"/>
                <Button fx:id="btnCerrarSesion" text="⌲ Cerrar Sesión" onAction="#handleCerrarSesion" styleClass="logout-button"/>
            </children>
            <padding>
                <Insets top="15" right="25" bottom="15" left="25"/>
            </padding>
        </HBox>

        <VBox alignment="CENTER" spacing="10" VBox.vgrow="ALWAYS">
            <children>
                <Label text="¿Qué deseas gestionar hoy?" styleClass="welcome-title"/>
                <Label text="Selecciona un módulo para comenzar" styleClass="welcome-subtitle"/>

                <HBox alignment="CENTER" spacing="25">
                    <children>

                        <VBox fx:id="cardClientes" styleClass="card, card-clientes" onMouseClicked="#abrirModuloClientes">
                            <children>
                                <AnchorPane styleClass="image-wrapper">
                                    <children>
                                        <ImageView fitHeight="150.0" fitWidth="280.0" pickOnBounds="true" preserveRatio="false" AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                                            <image>
                                                <Image url="@../Img/clientes.jpg" />
                                            </image>
                                        </ImageView>
                                        <Pane styleClass="gradient-overlay" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                                        <Label text="Clientes" styleClass="card-title-inside" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0"/>
                                    </children>
                                </AnchorPane>

                                <VBox spacing="12" styleClass="card-body" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label text="REGISTRO DE CLIENTES" styleClass="card-description" wrapText="true"/>
                                        <Region VBox.vgrow="ALWAYS"/>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label fx:id="lblCountClientes" text="0 registrados" styleClass="badge, badge-clientes"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label text="→" styleClass="arrow-icon, arrow-clientes"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <VBox fx:id="cardProductos" styleClass="card, card-productos" onMouseClicked="#abrirModuloProductos">
                            <children>
                                <AnchorPane styleClass="image-wrapper">
                                    <children>
                                        <ImageView fitHeight="150.0" fitWidth="280.0" pickOnBounds="true" preserveRatio="false" AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                                            <image>
                                                <Image url="@../Img/productos.jpg" />
                                            </image>
                                        </ImageView>
                                        <Pane styleClass="gradient-overlay" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                                        <Label text="Productos" styleClass="card-title-inside" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0"/>
                                    </children>
                                </AnchorPane>

                                <VBox spacing="12" styleClass="card-body" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label text="INVENTARIO DE PRODUCTOS" styleClass="card-description" wrapText="true"/>
                                        <Region VBox.vgrow="ALWAYS"/>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label fx:id="lblCountProductos" text="0 registrados" styleClass="badge, badge-productos"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label text="→" styleClass="arrow-icon, arrow-productos"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <VBox fx:id="cardPagos" styleClass="card, card-pagos" onMouseClicked="#abrirModuloPagos">
                            <children>
                                <AnchorPane styleClass="image-wrapper">
                                    <children>
                                        <ImageView fitHeight="150.0" fitWidth="280.0" pickOnBounds="true" preserveRatio="false" AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                                            <image>
                                                <Image url="@../Img/pagos.jpg" />
                                            </image>
                                        </ImageView>
                                        <Pane styleClass="gradient-overlay" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                                        <Label text="Pagos" styleClass="card-title-inside" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0"/>
                                    </children>
                                </AnchorPane>

                                <VBox spacing="12" styleClass="card-body" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label text="REGISTRO DE PAGOS DE MENSUALIDAD DE CLIENTES" styleClass="card-description" wrapText="true"/>
                                        <Region VBox.vgrow="ALWAYS"/>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label fx:id="lblCountPagos" text="0 registrados" styleClass="badge, badge-pagos"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label text="→" styleClass="arrow-icon, arrow-pagos"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                    </children>
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>