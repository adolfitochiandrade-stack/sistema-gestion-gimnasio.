<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox stylesheets="@../css/StyleReportes.css" styleClass="filtro-modal-container, filtro-modal-todo" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controlador.FiltroTodoController" spacing="16">
    <padding>
        <Insets top="24" right="26" bottom="22" left="26"/>
    </padding>
    <children>

        <VBox spacing="4">
            <children>
                <Label text="Reporte completo" styleClass="filtro-modal-title"/>
                <Label text="Elige el rango de fechas de cada módulo. Deja los campos vacíos para incluir todos los registros de ese módulo." styleClass="filtro-modal-subtitle" wrapText="true"/>
            </children>
        </VBox>

        <VBox spacing="8" styleClass="filtro-todo-seccion, filtro-todo-clientes">
            <children>
                <Label text="👤  Clientes" styleClass="filtro-todo-titulo-seccion"/>
                <HBox spacing="10">
                    <children>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Inicio" styleClass="filtro-field-label"/>
                                <DatePicker fx:id="dpClientesDesde" styleClass="filtro-date-picker" promptText="DD/MM/AAAA" maxWidth="Infinity"/>
                                <Label fx:id="lblErrorClientesDesde" styleClass="lbl-error" managed="false" visible="false" wrapText="true"/>
                            </children>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Final" styleClass="filtro-field-label"/>
                                <DatePicker fx:id="dpClientesHasta" styleClass="filtro-date-picker" promptText="DD/MM/AAAA" maxWidth="Infinity"/>
                                <Label fx:id="lblErrorClientesHasta" styleClass="lbl-error" managed="false" visible="false" wrapText="true"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <VBox spacing="8" styleClass="filtro-todo-seccion, filtro-todo-pagos">
            <children>
                <Label text="💲  Pagos" styleClass="filtro-todo-titulo-seccion"/>
                <HBox spacing="10">
                    <children>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Inicio" styleClass="filtro-field-label"/>
                                <DatePicker fx:id="dpPagosDesde" styleClass="filtro-date-picker" promptText="DD/MM/AAAA" maxWidth="Infinity"/>
                                <Label fx:id="lblErrorPagosDesde" styleClass="lbl-error" managed="false" visible="false" wrapText="true"/>
                            </children>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Final" styleClass="filtro-field-label"/>
                                <DatePicker fx:id="dpPagosHasta" styleClass="filtro-date-picker" promptText="DD/MM/AAAA" maxWidth="Infinity"/>
                                <Label fx:id="lblErrorPagosHasta" styleClass="lbl-error" managed="false" visible="false" wrapText="true"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <VBox spacing="8" styleClass="filtro-todo-seccion, filtro-todo-productos">
            <children>
                <Label text="📦  Productos" styleClass="filtro-todo-titulo-seccion"/>
                <HBox spacing="10">
                    <children>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Inicio" styleClass="filtro-field-label"/>
                                <DatePicker fx:id="dpProductosDesde" styleClass="filtro-date-picker" promptText="DD/MM/AAAA" maxWidth="Infinity"/>
                                <Label fx:id="lblErrorProductosDesde" styleClass="lbl-error" managed="false" visible="false" wrapText="true"/>
                            </children>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Final" styleClass="filtro-field-label"/>
                                <DatePicker fx:id="dpProductosHasta" styleClass="filtro-date-picker" promptText="DD/MM/AAAA" maxWidth="Infinity"/>
                                <Label fx:id="lblErrorProductosHasta" styleClass="lbl-error" managed="false" visible="false" wrapText="true"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <children>
                <Button text="Limpiar Todo" onAction="#limpiarFiltros" styleClass="btn-filtro-limpiar"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Cancelar" onAction="#cancelar" styleClass="btn-filtro-cancelar"/>
                <Button fx:id="btnGuardar" text="Guardar" onAction="#guardar" styleClass="btn-filtro-guardar"/>
            </children>
        </HBox>

    </children>
</VBox>